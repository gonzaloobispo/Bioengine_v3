rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // Helper Functions
    // =============================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // =============================================
    // Catalog — lectura pública, escritura solo admin
    // =============================================
    match /catalog/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =============================================
    // Catalog Proposals — usuario crea, admin gestiona
    // =============================================
    match /catalog_proposals/{proposalId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.proposedBy == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =============================================
    // User Profiles and Subcollections
    // =============================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      // Subcollections generales: lectura y escritura del dueño
      match /{subcollection}/{document=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // secrets: solo lectura desde cliente; escritura solo vía Admin SDK (backend)
      match /secrets/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // llm_usage: solo lectura desde cliente; escritura solo vía Admin SDK (backend)
      match /llm_usage/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // =============================================
    // Telegram Mappings — solo admin vía backend
    // =============================================
    match /telegram_mappings/{telegramId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =============================================
    // Chat Messages (legacy)
    // =============================================
    match /messages/{messageId} {
      allow read: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;
    }

    // =============================================
    // Chat Turns — dueño o admin
    // =============================================
    match /chats/{chatId} {
      allow read, write: if isAuthenticated()
                         && (request.auth.uid == chatId || isAdmin());

      match /turns/{turnId} {
        allow read, write: if isAuthenticated()
                           && (request.auth.uid == chatId || isAdmin());
      }
    }

    // =============================================
    // HITL Actions — solo admin
    // =============================================
    match /hitl_actions/{actionId} {
      allow read, write: if isAdmin();
    }

    // =============================================
    // Processed Updates — solo Admin SDK
    // =============================================
    match /processed_updates/{updateId} {
      allow read, write: if false;
    }

    // =============================================
    // Delegated Tasks
    // =============================================
    match /delegated_tasks/{taskId} {
      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin()
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // =============================================
    // Audit Logs — solo Admin SDK
    // =============================================
    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    // =============================================
    // User Settings
    // =============================================
    match /user_settings/{settingsId} {
      allow read: if isAdmin()
                  || (isAuthenticated() && settingsId == request.auth.uid);
      allow write: if false;
    }

    // =============================================
    // Sent Alerts — solo Admin SDK
    // =============================================
    match /sent_alerts/{alertId} {
      allow read, write: if false;
    }

    // =============================================
    // Memory Key-Value — solo Admin SDK
    // =============================================
    match /memory_key_value/{key} {
      allow read, write: if false;
    }

    // =============================================
    // Deny all other collections by default
    // =============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
